{
  "name": "@wildboar/asn1-lsp",
  "version": "1.0.2",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@wildboar/asn1": "jsr:@wildboar/asn1@^11.3.0",
    "@wildboar/asn1-parser": "jsr:@wildboar/asn1-parser@^2.7.1"
  },
  "tasks": {
    "check": "deno check --minimum-dependency-age=0 mod.ts cli.ts",
    "test": "deno test -A --minimum-dependency-age=0 --quiet",
    "compile": "deno compile -A --minimum-dependency-age=0 --output asn1-lsp cli.ts"
  },
  "publish": {
    "include": [
      "LICENSE.txt",
      "README.md",
      "mod.ts",
      "cli.ts",
      "src/**/*.ts"
    ],
    "exclude": [
      "test/",
      "testdata/",
      "vscode-asn1/"
    ]
  },
  "fmt": {
    "exclude": ["vscode-asn1/"]
  },
  "lint": {
    "exclude": ["vscode-asn1/"]
  },
  "test": {
    "exclude": ["vscode-asn1/"]
  },
  "nodeModulesDir": "none"
}
